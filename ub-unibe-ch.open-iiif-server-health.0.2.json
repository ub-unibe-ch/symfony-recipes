{
    "manifests": {
        "ub-unibe-ch/open-iiif-server-health": {
            "manifest": {
                "bundles": {
                    "OpenIIIFServer\\Health\\HealthBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "env": {
                    "#1": "Comma-separated IPs/CIDRs allowed to access the actuator endpoints",
                    "ACTUATOR_INFO_IPS": "127.0.0.1,::1",
                    "ACTUATOR_HEALTH_IPS": "127.0.0.1,::1"
                }
            },
            "files": {
                "config/routes/iiif_server_health.yaml": {
                    "contents": [
                        "iiif_server_health:",
                        "    resource: '@SymSensorActuatorBundle/config/routing.yaml'",
                        "    prefix: /_actuator",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "d42c6e7e9bd57b485937fab3c47f3b30d9bdf726"
        }
    }
}
